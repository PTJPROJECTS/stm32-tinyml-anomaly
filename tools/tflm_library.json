{
  "name": "tflm",
  "version": "0.0.0",
  "description": "TFLite Micro + CMSIS-NN tree generated by tools/fetch_tflm.sh",
  "build": {
    "flags": [
      "-I.",
      "-Ithird_party/flatbuffers/include",
      "-Ithird_party/kissfft",
      "-Ithird_party/cmsis_nn",
      "-Ithird_party/cmsis_nn/Include",
      "-Ithird_party/cmsis/CMSIS/Core/Include",
      "-DTF_LITE_STATIC_MEMORY",
      "-DCMSIS_NN",
      "-Wno-unused-parameter"
    ],
    "includeDir": ".",
    "srcFilter": [
      "+<tensorflow/>",
      "+<third_party/cmsis_nn/Source/>",
      "-<signal/>",
      "-<third_party/kissfft/>",
      "-<tensorflow/lite/micro/cortex_m_generic/micro_time.cc>"
    ]
  }
}
